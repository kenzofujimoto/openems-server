# Runtime of the HTTP server image only. The core service (app/service.py) needs none of these.
# The image installs requirements.txt: every transitive pin with hashes, compiled from this file
# on Linux/Python 3.14 (Dependabot regenerates it in the same layout):
#   docker run --rm -v "$PWD:/w" -w /w python:3.14-slim sh -c "pip install -q pip-tools==7.6.2 && pip-compile --generate-hashes --allow-unsafe --strip-extras requirements.in"
# Test and lint tools live in requirements-dev.txt.
fastapi==0.162.0
uvicorn==0.54.0           # without [standard]: no reload watcher, websockets or dotenv in production
httptools==0.9.0          # uvicorn HTTP parser
uvloop==0.23.0; sys_platform != "win32"
python-multipart==0.0.32   # SAML ACS form POST
psycopg[binary]==3.3.6     # PostgresStore
redis==8.1.0               # RedisQueue
signxml==5.2.0             # SAML XML-DSig verification (pulls lxml + cryptography)
defusedxml==0.7.1          # Hardened parsing of untrusted SAML XML
tzdata==2026.5             # IANA zones for policy schedules (Windows has no system database)
