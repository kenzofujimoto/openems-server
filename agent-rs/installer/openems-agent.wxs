<?xml version="1.0" encoding="UTF-8"?>
<!--
  Per-machine MSI for the native openems agent (WiX Toolset 5).

  Build:   wix build installer/openems-agent.wxs -arch x64 -d Version=0.1.0 -d AgentExe=target/release/openems-agent.exe -o openems-agent.msi
  Install: msiexec /i openems-agent.msi /qn SERVER=https://ems.example.com INVITATION=<one-time code> [VDOM=Default] [DEVID=name]

  The executable lives in Program Files (writable only by administrators); the
  configuration, state and logs live in the protected ProgramData\openems folder.
  Uninstalling removes the service and clears only the managed hosts block; state
  and logs are kept for troubleshooting, like the Python installer did.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="openems endpoint agent" Manufacturer="RSM Brasil" Version="$(var.Version)"
           UpgradeCode="0C684B18-7540-4865-9516-567A9E81AA61" Scope="perMachine" Compressed="yes">
    <SummaryInformation Description="openems endpoint agent" />
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of the openems agent is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="SERVER" Secure="yes" />
    <Property Id="INVITATION" Secure="yes" Hidden="yes" />
    <Property Id="VDOM" Value="Default" Secure="yes" />
    <Property Id="DEVID" Secure="yes" />
    <Property Id="HOSTSFILE" Secure="yes" />
    <Property Id="BLOCKPAGE" Secure="yes" />
    <Property Id="BLOCKPAGEHTTPS" Secure="yes" />
    <Property Id="DNSFILTER" Secure="yes" />
    <SetProperty Id="DEVID" Value="[ComputerName]" Before="CostFinalize" Sequence="execute" Condition="NOT DEVID" />
    <SetProperty Id="HOSTSFILE" Value="[System64Folder]drivers\etc\hosts" Before="CostFinalize" Sequence="execute" Condition="NOT HOSTSFILE" />
    <SetProperty Id="BlockPageArguments" Value="--block-page" Before="CostFinalize" Sequence="execute" Condition="BLOCKPAGE=&quot;1&quot; OR BLOCKPAGEHTTPS=&quot;1&quot;" />
    <SetProperty Id="HttpsBlockPageArguments" Value="--block-page-https" Before="CostFinalize" Sequence="execute" Condition="BLOCKPAGEHTTPS=&quot;1&quot;" />
    <SetProperty Id="DnsFilterArguments" Value="--dns-filter" Before="CostFinalize" Sequence="execute" Condition="DNSFILTER=&quot;1&quot;" />

    <Launch Condition="Installed OR WIX_UPGRADE_DETECTED OR SERVER" Message="Pass SERVER=https://your-ems-server on the msiexec command line." />
    <Launch Condition="Privileged" Message="The openems agent must be installed by an administrator." />
    <Launch Condition="NOT BLOCKPAGE OR BLOCKPAGE=&quot;1&quot;" Message="BLOCKPAGE accepts only 1 or omission. Omit it to preserve an existing setting." />
    <Launch Condition="NOT BLOCKPAGEHTTPS OR BLOCKPAGEHTTPS=&quot;1&quot;" Message="BLOCKPAGEHTTPS accepts only 1 or omission. HTTPS also enables the HTTP page." />
    <Launch Condition="NOT DNSFILTER OR DNSFILTER=&quot;1&quot;" Message="DNSFILTER accepts only 1 or omission. Omit it to preserve an existing setting." />

    <!-- Embedded executable remains available during rollback and uninstall commit. -->
    <Binary Id="AgentActions" SourceFile="$(var.AgentExe)" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="openems">
        <Component Id="AgentExecutable" Guid="6F1D2A2E-0F5B-4C7A-9A8E-3D0B5E1C7A11">
          <File Id="AgentExe" Source="$(var.AgentExe)" Name="openems-agent.exe" KeyPath="yes" />
          <ServiceInstall Id="AgentService" Name="openems-agent" DisplayName="openems endpoint agent"
                          Description="Applies RSM endpoint policies and reports their status to the management server."
                          Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Arguments="service" />
          <ServiceControl Id="AgentServiceControl" Name="openems-agent" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Runs as LocalSystem before the service starts; writes the protected agent.json. -->
    <CustomAction Id="PrepareAgentSetup" BinaryRef="AgentActions" Execute="deferred" Impersonate="no" Return="check" HideTarget="yes"
                  ExeCommand="installer-prepare --server &quot;[SERVER]&quot; --devid &quot;[DEVID]&quot; --vdom &quot;[VDOM]&quot; --hosts-file &quot;[HOSTSFILE]&quot; --invitation &quot;[INVITATION]&quot; [BlockPageArguments] [HttpsBlockPageArguments] [DnsFilterArguments]" />
    <CustomAction Id="RollbackAgentSetup" BinaryRef="AgentActions" Execute="rollback" Impersonate="no" Return="check"
                  ExeCommand="installer-rollback" />
    <CustomAction Id="CommitAgentSetup" BinaryRef="AgentActions" Execute="commit" Impersonate="no" Return="check"
                  ExeCommand="installer-commit" />
    <CustomAction Id="PrepareAgentRemoval" BinaryRef="AgentActions" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="installer-prepare --remove" />
    <CustomAction Id="RollbackAgentRemoval" BinaryRef="AgentActions" Execute="rollback" Impersonate="no" Return="check"
                  ExeCommand="installer-rollback" />
    <CustomAction Id="CommitAgentRemoval" BinaryRef="AgentActions" Execute="commit" Impersonate="no" Return="check"
                  ExeCommand="installer-commit" />
    <!-- Windows Installer cannot set restart actions itself (error 1939); the agent does it. -->
    <CustomAction Id="ConfigureRecovery" FileRef="AgentExe" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="configure-recovery" />

    <!-- Sandbox fixtures only (-d FaultInjection=1): fail late so MSI rollback runs. -->
    <?ifdef FaultInjection ?>
    <Property Id="FAIL_SETUP" Secure="yes" />
    <Property Id="FAIL_REMOVAL" Secure="yes" />
    <CustomAction Id="InjectSetupFailure" Directory="System64Folder" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="&quot;[System64Folder]cmd.exe&quot; /c exit 1" />
    <CustomAction Id="InjectRemovalFailure" Directory="System64Folder" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="&quot;[System64Folder]cmd.exe&quot; /c exit 1" />
    <InstallExecuteSequence>
      <Custom Action="InjectSetupFailure" After="StartServices" Condition="FAIL_SETUP=&quot;1&quot; AND NOT REMOVE" />
      <Custom Action="InjectRemovalFailure" After="RemoveFiles" Condition="FAIL_REMOVAL=&quot;1&quot; AND REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
    <?endif?>

    <InstallExecuteSequence>
      <Custom Action="RollbackAgentRemoval" Before="PrepareAgentRemoval" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="PrepareAgentRemoval" After="StopServices" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="CommitAgentRemoval" After="PrepareAgentRemoval" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="ConfigureRecovery" After="InstallServices" Condition="NOT REMOVE" />
      <Custom Action="RollbackAgentSetup" Before="PrepareAgentSetup" Condition="NOT REMOVE" />
      <Custom Action="PrepareAgentSetup" Before="StartServices" Condition="NOT REMOVE" />
      <Custom Action="CommitAgentSetup" After="PrepareAgentSetup" Condition="NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
